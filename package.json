{
  "name": "continuum",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "ngrok": "node scripts/start-ngrok.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node -r dotenv/config node_modules/.bin/tsx prisma/seed.ts dotenv_config_path=.env.local",
    "db:clean-users": "node -r dotenv/config node_modules/.bin/tsx scripts/clean-user-data.ts dotenv_config_path=.env.local",
    "db:test": "node -r dotenv/config node_modules/.bin/tsx scripts/test-db-connection.ts dotenv_config_path=.env.local",
    "test:repos": "node -r dotenv/config node_modules/.bin/tsx scripts/test-repositories.ts dotenv_config_path=.env.local",
    "test:bot": "node -r dotenv/config node_modules/.bin/tsx scripts/test-bot-conversation.ts dotenv_config_path=.env.local",
    "deploy:dev": "npx vercel --target development",
    "deploy:preview": "npx vercel",
    "deploy:prod": "npx vercel --prod",
    "cf:build": "next build && npx @opennextjs/cloudflare build",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "cf:dev": "wrangler dev"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^7.2.0",
    "@prisma/client": "^6.19.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-table": "^8.21.3",
    "@types/bcrypt": "^6.0.0",
    "apexcharts": "^5.3.6",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.4.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-apexcharts": "^1.9.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-phone-number-input": "^3.4.14",
    "swr": "^2.3.8",
    "tailwind-merge": "^3.4.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@opennextjs/cloudflare": "^1.14.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^6.19.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "^4.54.0"
  }
}
